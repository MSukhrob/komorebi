# Copy to .env and fill in real values
NODE_ENV=development
PORT=4100
DATABASE_URL=postgres://komorebi:change-me@127.0.0.1:5433/komorebi
# Used by docker-compose.yml to create the database user
POSTGRES_PASSWORD=change-me
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
# true when served over HTTPS (Secure cookies)
COOKIE_SECURE=false
# TMDB "API Read Access Token" or v3 API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# password of the presenter demo account "Sukhrob" (npm run seed)
SUKHROB_PASSWORD=
